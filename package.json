{
  "name": "skillet-shared",
  "version": "0.5.0",
  "description": "Code shared by bender and videoskillet",
  "license": "MIT",
  "author": "Colin Diesh",
  "repository": "github:cmdcolin/skillet-shared",
  "type": "module",
  "exports": {
    "./history": {
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./relative-time": {
      "types": "./dist/relative-time.d.ts",
      "default": "./dist/relative-time.js"
    },
    "./posts": {
      "types": "./dist/posts.d.ts",
      "default": "./dist/posts.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./wire-route": {
      "types": "./dist/wire-route.d.ts",
      "default": "./dist/wire-route.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./site-info": {
      "types": "./dist/site-info.d.ts",
      "default": "./dist/site-info.js"
    },
    "./components/SiteBar.astro": "./components/SiteBar.astro",
    "./components/Footer.astro": "./components/Footer.astro",
    "./components/SocialMeta.astro": "./components/SocialMeta.astro",
    "./components/SignedInHint.astro": "./components/SignedInHint.astro",
    "./site.css": "./css/site.css",
    "./footer.css": "./css/footer.css",
    "./saved-list": {
      "types": "./dist/saved-list.d.ts",
      "default": "./dist/saved-list.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "default": "./dist/cloud.js"
    }
  },
  "files": [
    "dist",
    "components",
    "css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css dist/",
    "prepack": "pnpm build",
    "preversion": "pnpm typecheck && pnpm test",
    "postversion": "git push --follow-tags"
  },
  "peerDependencies": {
    "astro": "^7.4.2",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "firebase": "13.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
